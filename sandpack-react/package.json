{
  "name": "@codesandbox/sandpack-react",
  "version": "2.20.0",
  "description": "",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/sandpack.git",
    "directory": "sandpack-react"
  },
  "license": "Apache-2.0",
  "author": "CodeSandbox",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/src/types.d.ts",
  "exports": {
    "./unstyled": {
      "types": "./dist/unstyled.d.ts",
      "import": "./dist/unstyled/index.mjs",
      "require": "./dist/unstyled/index.js"
    },
    "./styles.css": "./dist/styles.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "test": "TZ=UTC TEST_ENV=true jest . --transformIgnorePatterns \"node_modules/(?!(@codemirror|@zenfs))/\" --modulePathIgnorePatterns \"e2e\"",
    "lint": "eslint '**/*.ts?(x)' --fix",
    "build": "rollup -c",
    "build:publish": "yarn clean && yarn build",
    "dev": "storybook dev -p 6006 --quiet",
    "typecheck": "tsc",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx}'",
    "format:check": "prettier --check '**/*.{ts,tsx}'"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.10.6",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.3",
    "@lofcz/sandpack-client": "^2.19.9",
    "@lezer/highlight": "^1.2.1",
    "@zenfs/core": "~2.3.11",
    "@react-hook/intersection-observer": "^3.1.2",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "anser": "^2.3.2",
    "clean-set": "^1.1.2",
    "dequal": "^2.0.3",
    "escape-carriage": "^1.3.1",
    "lz-string": "^1.5.0",
    "react-devtools-inline": "^6.0.1",
    "react-is": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/legacy-modes": "^6.4.1",
    "@codesandbox/sandpack-themes": "^2.0.21",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/jest-transform": "^1.1.22",
    "@vanilla-extract/rollup-plugin": "^1.5.3",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "acorn-walk": "^8.3.4",
    "astring": "^1.9.0",
    "rollup-plugin-filesize": "^10.0.0",
    "storybook": "^8.4.7",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17 || ^18 || ^19",
    "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
  }
}
