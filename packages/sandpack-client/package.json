{
  "name": "@lofcz/sandpack-client",
  "version": "2.20.9",
  "description": "Fork of @codesandbox/sandpack-client with ZenFS / immutable-fetch patches for sciobot",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/sandpack.git",
    "directory": "packages/sandpack-client"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "Apache-2.0",
  "author": "CodeSandbox",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./sandpack/*": "./sandpack/*",
    "./clients/runtime": {
      "types": "./dist/clients/runtime/index.d.ts",
      "import": "./dist/clients/runtime/index.mjs",
      "require": "./dist/clients/runtime/index.js"
    },
    "./clients/node": {
      "types": "./dist/clients/node/index.d.ts",
      "import": "./dist/clients/node/index.mjs",
      "require": "./dist/clients/node/index.js"
    },
    "./clients/static": {
      "types": "./dist/clients/static/index.d.ts",
      "import": "./dist/clients/static/index.mjs",
      "require": "./dist/clients/static/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"for (const dir of ['dist', 'sandpack', 'src/inject-scripts/dist']) require('fs').rmSync(dir, { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "rslib build",
    "build:publish": "npm run build && npm run build:runtime",
    "build:runtime": "node scripts/build-runtime.mjs",
    "dev": "npm run clean && rslib build --watch",
    "test": "rstest run",
    "typecheck": "tsc --noEmit",
    "lint": "rslint .",
    "lint:fix": "rslint --fix .",
    "format": "prettier --write \"**/*.{ts,mts}\"",
    "format:check": "prettier --check \"**/*.{ts,mts}\"",
    "prepublishOnly": "npm run build:publish"
  },
  "files": [
    "dist",
    "sandpack",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "@codesandbox/nodebox": "0.1.9",
    "buffer": "^6.0.3",
    "dequal": "^2.0.3",
    "mime-db": "^1.54.0",
    "outvariant": "^1.4.3",
    "static-browser-server": "1.1.0"
  },
  "devDependencies": {
    "@rslib/core": "^1.1.0",
    "@rslint/core": "^0.10.1",
    "@rstest/core": "^0.12.6",
    "@types/mime-db": "^1.43.6",
    "@types/node": "^26.6.11",
    "@zenfs/core": "~2.9.0",
    "console-feed": "3.8.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@zenfs/core": "^2.3.11 || ^2.5.8"
  }
}
