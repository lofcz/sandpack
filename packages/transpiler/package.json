{
  "name": "@lofcz/transpiler",
  "version": "0.10.0",
  "description": "The single source of truth for immediately.run's per-file transform chain (MDX + Babel + react-refresh), shared byte-for-byte between the browser sandbox bundler and the CLI's pre-transpiled-artifact emitter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/sandpack.git",
    "directory": "packages/transpiler"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "import": "./dist/css.js",
      "require": "./dist/css.cjs"
    }
  },
  "files": [
    "dist",
    "worker"
  ],
  "sideEffects": false,
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "prebuild": "node scripts/gen-version.mjs",
    "build": "rslib build",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "rslint .",
    "gen:golden": "node scripts/gen-golden.mjs",
    "test": "npm run build && rstest run",
    "test:worker": "npm run build && rstest run --include test/babel-worker.harness.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/standalone": "8.1.4",
    "@immediately-run/mdx-plugins": "^0.8.0",
    "@immediately-run/worker-transport": "^0.1.0",
    "@mdx-js/mdx": "3.1.1",
    "css-tree": "3.2.1",
    "react-refresh": "0.19.0",
    "remark-gfm": "4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.4",
    "@babel/helper-compilation-targets": "8.0.7",
    "@microsoft/api-extractor": "^7.60.2",
    "@noble/hashes": "^2.4.0",
    "@rslib/core": "^1.1.0",
    "@rslint/core": "^0.10.1",
    "@rspack/core": "^2.3.4",
    "@rstest/core": "^0.12.6",
    "@types/css-tree": "^3.2.0",
    "babel-plugin-polyfill-corejs3": "1.0.0",
    "core-js": "3.51.0",
    "core-js-compat": "3.51.0",
    "typescript": "^7.0.2",
    "unified": "11.0.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}