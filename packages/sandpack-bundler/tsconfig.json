{
  "compilerOptions": {
    "strict": true,
    "module": "es2020",
    "target": "esnext",
    "jsx": "preserve",

    "esModuleInterop": true,
    "sourceMap": true,
    "allowJs": true,
    "lib": ["esnext", "dom"],
    "types": ["node", "@rstest/core/globals"],
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": ["src", "shims", "rsbuild.config.mts", "rstest.config.mts", "rstest.setup.ts"],
  "exclude": ["node_modules", "dist", "fixture"]
}
