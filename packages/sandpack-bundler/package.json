{
  "name": "sandpack-bundler",
  "version": "2.0.0",
  "description": "The bundler powering sandpack",
  "engines": {
    "node": "24"
  },
  "license": "Apache-2.0",
  "author": "CodeSandbox",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/codesandbox/sandpack-bundler"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "rsbuild dev",
    "start": "rsbuild preview --port 4587",
    "gen:sdk-versions": "node scripts/gen-sdk-versions.mjs",
    "gen:toolchain-hash": "node scripts/gen-toolchain-hash.mjs",
    "build": "npm run gen:sdk-versions && npm run gen:toolchain-hash && rsbuild build",
    "test": "rstest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./src/**/*.{ts,tsx,js,jsx,json}\"",
    "lint": "rslint"
  },
  "browserslist": "> 2.5%, not ie 11, not dead, not op_mini all",
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@lofcz/transpiler": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "@msgpack/msgpack": "^3.1.3",
    "@swc/helpers": "0.5.24",
    "@zenfs/core": "^2.9.0",
    "acorn": "^8.19.0",
    "console-feed": "3.8.0",
    "css-tree": "3.2.1",
    "gensync": "^1.0.0-beta.2",
    "kerium": "^1.5.0",
    "lightningcss-wasm": "^1.33.0",
    "p-queue": "^10.0.0",
    "picomatch": "^4.0.7",
    "remark-gfm": "^4.0.1",
    "settle-promise": "^1.0.0",
    "strip-json-comments": "^5.1.0",
    "unified": "^11.0.5",
    "url-join": "^6.0.0",
    "vfile-message": "^4.0.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@rsbuild/core": "^2.3.5",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@rslint/core": "^0.10.1",
    "@rstest/core": "^0.12.6",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.11",
    "@types/picomatch": "^4.0.3",
    "buffer": "^6.0.3",
    "jsdom": "^31.0.1",
    "path-browserify": "^1.0.1",
    "prettier": "^3.10.1",
    "process": "^0.11.10",
    "typescript": "^7.0.2"
  }
}
