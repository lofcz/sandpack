{
  "name": "sandpack-bundler",
  "version": "2.0.0",
  "description": "The bundler powering sandpack",
  "engines": {
    "node": "24"
  },
  "license": "Apache-2.0",
  "author": "CodeSandbox",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/codesandbox/sandpack-bundler"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.parcel-cache',{recursive:true,force:true})\"",
    "dev": "parcel ./src/index.html",
    "start": "node ./server.js",
    "gen:sdk-versions": "node scripts/gen-sdk-versions.mjs",
    "gen:toolchain-hash": "node scripts/gen-toolchain-hash.mjs",
    "build": "npm run gen:sdk-versions && npm run gen:toolchain-hash && npm run build:parcel",
    "build:parcel": "parcel build ./src/index.html --target default --no-scope-hoist",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"./src/**/*.{ts,tsx,js,jsx,json}\"",
    "lint": "eslint '**/*.ts?(x)'",
    "deploy": "firebase deploy"
  },
  "importSort": {
    ".js, .jsx, .ts, .tsx": {
      "style": "module",
      "parser": "typescript"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "pretty-quick --write"
    ]
  },
  "browserslist": "> 2.5%, not ie 11, not dead, not op_mini all",
  "targets": {
    "default": {
      "distDir": "dist",
      "context": "browser",
      "includeNodeModules": true,
      "publicUrl": "./"
    }
  },
  "dependencies": {
    "@babel/plugin-proposal-explicit-resource-management": "7.27.4",
    "@babel/standalone": "7.29.16",
    "@lofcz/transpiler": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "@msgpack/msgpack": "^3.1.3",
    "@swc/helpers": "0.5.24",
    "@types/babel__standalone": "7.1.9",
    "@types/mdast": "^4.0.4",
    "@zenfs/core": "^2.9.0",
    "acorn": "^8.19.0",
    "babel-preset-solid": "^1.9.19",
    "console-feed": "3.8.0",
    "css-tree": "3.2.1",
    "gensync": "^1.0.0-beta.2",
    "kerium": "^1.5.0",
    "lightningcss-wasm": "^1.33.0",
    "micromatch": "^4.0.8",
    "p-queue": "^6.6.2",
    "postcss": "^8.5.34",
    "postcss-url": "^10.1.4",
    "postcss-value-parser": "^4.2.0",
    "react": "19.3.1",
    "react-refresh": "0.19.0",
    "remark-gfm": "^4.0.1",
    "settle-promise": "^1.0.0",
    "solid-refresh": "^0.7.8",
    "source-map": "^0.6.1",
    "strip-json-comments": "^5.1.0",
    "unified": "^11.0.5",
    "url-join": "^6.0.0",
    "vfile-message": "^4.0.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@octokit/rest": "^18.12.0",
    "@parcel/config-default": "2.16.4",
    "@swc-node/jest": "^1.10.1",
    "@types/css-tree": "^3.2.0",
    "@types/jest": "^27.4.1",
    "@types/micromatch": "^4.0.10",
    "@types/postcss-url": "^10.0.4",
    "@types/url-join": "^4.0.1",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.28.0",
    "@typescript-eslint/parser": "^5.28.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "eslint": "^7.32.0 || ^8.2.0",
    "events": "^3.3.0",
    "fastify": "^3.28.0",
    "fastify-static": "^4.7.0",
    "firebase-tools": "^14.4.0",
    "gzip-size": "^7.0.0",
    "import-sort-style-module": "^6.0.0",
    "jest": "^27.5.1",
    "jest-extended": "^2.0.0",
    "node-fetch": "^3.3.2",
    "os-browserify": "^0.3.0",
    "parcel": "2.16.4",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "path-browserify": "^1.0.1",
    "prettier": "^2.6.2",
    "prettier-plugin-import-sort": "^0.0.7",
    "pretty-quick": "^3.1.3",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "typescript": "5.9.3",
    "url": "^0.11.4",
    "util": "^0.12.5"
  },
  "resolutions": {
    "@babel/preset-env": "7.27.0",
    "@swc/core": "1.11.24",
    "react": "19.1.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}